{
  "manifest_version": 3,
  "name": "scribe",
  "version": "0.1.0",
  "description": "Transcribe a browser call (Google Meet or any tab) on your own scribe server. No bot joins the call.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "webNavigation"],
  "host_permissions": [
    "http://harry-box/*",
    "http://*.ts.net/*",
    "https://*.ts.net/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_popup": "src/popup.html", "default_title": "scribe" },
  "options_page": "src/options.html"
}
