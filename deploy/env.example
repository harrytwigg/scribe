# ~/.config/scribe/env, read by both systemd units. Holds no secrets itself.

# Loopback plus this machine's tailnet address. There is no API token, so whoever can reach these
# addresses can use the server; each must be an IP address
# written out (not 0.0.0.0, ::, 0 or a name): the server refuses to listen on every interface.
SCRIBE_HOST=127.0.0.1,100.x.y.z
SCRIBE_PORT=8787
# A JSON file of secrets: the bot token under SCRIBE_DISCORD_TOKEN_KEY.
SCRIBE_SECRETS_FILE=/path/to/api-keys.json
SCRIBE_DISCORD_TOKEN_KEY=SCRIBE_DISCORD_BOT_TOKEN
SCRIBE_SERVER_URL=http://127.0.0.1:8787
# Register slash commands in one server only (instant). Unset registers them globally.
SCRIBE_GUILD_ID=
# Shown when a call ends, so people know where the transcript is.
SCRIBE_PUBLIC_URL=http://scribe-host:8787
# SCRIBE_ECHO=1            # also post transcript lines in the voice channel's chat (off by default)
# SCRIBE_KEEP_AUDIO=1      # keep utterance WAVs under the data dir (off by default)
# SCRIBE_DEBUG_VOICE=1     # log @discordjs/voice and DAVE debug messages
# SCRIBE_BROWSER_IDLE_SECONDS=300  # end a browser (extension) session silent this long
# SCRIBE_DIARIZATION=0       # turn off splitting a browser call's tab into speakers (on by default)
# SCRIBE_EXTENSION_ORIGINS=   # origins of Chrome extensions allowed to call the API; the default
#                             # is the scribe extension in extension/, empty turns it off
# Call recordings (browser calls; docs/spec.md, 4.4). Raw call audio, kept in the data dir.
# SCRIBE_RECORD_CALLS=0              # do not accept recordings at all (on by default)
# SCRIBE_RECORDING_KEEP_DAYS=14      # delete a call's audio this long after it ended
# SCRIBE_RECORDING_AFTER_REPROCESS_DAYS=3   # ...or this long after a pass left no gap in its transcript
# SCRIBE_RECORDING_MAX_MB=10240      # together, at most this much; the oldest go first
# SCRIBE_AUTO_REPROCESS=0            # do not fill a call's gaps by itself when the server is idle
# SCRIBE_DIARIZATION_THREADS=4       # default: half the cores, at most 8
